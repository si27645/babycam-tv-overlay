<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_frame_background">

    <!-- OverlayService populates this at runtime with 1-4 camera cells,
         depending on layout mode and how many cameras are enabled. -->
    <LinearLayout
        android:id="@+id/overlay_grid_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

</FrameLayout>
